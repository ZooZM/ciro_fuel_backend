NODE_ENV=development
PORT=3000

# MongoDB (replica set REQUIRED for transactions)
# Running the app on the host against docker-compose Mongo: the replica set
# advertises its member as `mongo:27017`, which only resolves inside the Docker
# network, so `replicaSet=rs0` here fails with `ENOTFOUND mongo`. directConnection
# skips that discovery step; transactions still work because the server remains a
# replica set primary. Inside Docker (the compose `app` service) use
# `mongodb://mongo:27017/ciro_fuel?replicaSet=rs0` instead.
MONGODB_URI=mongodb://127.0.0.1:27017/ciro_fuel?directConnection=true

# Redis (BullMQ payment-timeout delayed jobs)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-to-a-random-64-hex-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-a-different-random-64-hex-string
JWT_REFRESH_EXPIRES_IN=7d

# Payment gateways (Sadad/Mada webhook HMAC secrets)
PAYMENT_SADAD_SECRET=change-me
PAYMENT_MADA_SECRET=change-me
PAYMENT_DEADLINE_MINUTES=30

# Proof of delivery
OTP_EXPIRY_MINUTES=30

# File storage — directory name MUST remain exactly "sys_storge"
STORAGE_DIR=sys_storge
MAX_FILE_SIZE_BYTES=10485760

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Driver presence
PRESENCE_OFFLINE_MINUTES=6
PRESENCE_SWEEP_SECONDS=60

# Tracking policy
TRACKING_DISPLACEMENT_METERS=50
TRACKING_HEARTBEAT_MINUTES=3

# spec 008 FR-030b — how close to the assigned warehouse a driver must be
# for their loading-stage vehicle verification to be accepted.
WAREHOUSE_GEOFENCE_RADIUS_METERS=500

# spec 010 FR-012/FR-013a — assignment acknowledgment window and the escalation
# SMS send-rate cap (at most _MAX sends per _DURATION_MS window).
ASSIGNMENT_ACK_WINDOW_MINUTES=3
ASSIGNMENT_ESCALATION_SMS_RATE_LIMIT_MAX=20
ASSIGNMENT_ESCALATION_SMS_RATE_LIMIT_DURATION_MS=60000

# spec 011 FR-001/FR-003/FR-009/FR-019 — in-transit stop detection.
# STOP_DETECTION_MOVEMENT_METERS should track TRACKING_DISPLACEMENT_THRESHOLD_METERS:
# the two answering differently would let the platform call one driver both
# "moving" (tracking) and "stopped" (alerting) at the same instant.
# STOP_DETECTION_SWEEP_SECONDS is deliberately overridable — set it low in
# tests and in the quickstart walkthrough so neither waits a real minute.
STOP_DETECTION_WINDOW_MINUTES=10
STOP_DETECTION_MOVEMENT_METERS=50
STOP_RESPONSE_WINDOW_MINUTES=5
STOP_DETECTION_SWEEP_SECONDS=60

# Seed script (scripts/seed-super-admin.ts)
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_PASSWORD=change-me-please-16chars
SUPER_ADMIN_FULL_NAME=Platform Owner
# spec 015 R5 — an admin's phone is now a login identifier. A real E.164
# number is REQUIRED by the seed script (the old literal 'N/A' would collide
# with the extended partial unique phone index).
SUPER_ADMIN_PHONE=+966500000000

# Order ETA approximation (spec 004, plan.md §5): straight-line distance ÷ average speed
ORDER_AVERAGE_SPEED_KMH=60

# How long a quote (POST /orders/quote) stays valid before POST /orders needs a fresh one
ORDER_QUOTE_EXPIRY_MINUTES=10

# Reverse-geocoding at client registration only (spec 004 FR-011). Optional — its
# absence must never block account creation (FR-013); the address field stays
# empty and editable when unset.
GOOGLE_MAPS_API_KEY=

# SMS (spec 005 phone verification; spec 015 activates Taqnyat). 'none' is the
# development no-op sender — it logs the code instead of sending it, and is
# REJECTED at boot when NODE_ENV=production. 'taqnyat' is the procured Saudi
# provider.
#
# spec 015 R6 / FR-009 — the deployment supplies these under different names;
# they map onto the platform's settings as follows:
#   SMS_SENDER        -> SMS_SENDER_ID   (value: ciro — must be an approved
#                                         sender on the Taqnyat account)
#   SMS_BEARER_TOKEN  -> SMS_API_KEY     (the bearer token / secret)
#   SMS_ENDPOINT_URL  -> SMS_ENDPOINT_URL (unchanged)
#   (implied)         -> SMS_PROVIDER=taqnyat
#
# When SMS_PROVIDER=taqnyat, BOTH SMS_API_KEY and SMS_SENDER_ID are required
# and must be non-empty — a blank value (set-but-empty included) refuses to
# boot, wherever someone believes they configured Taqnyat.
SMS_PROVIDER=taqnyat
SMS_API_KEY=                       # Taqnyat bearer token (deployment: SMS_BEARER_TOKEN)
SMS_SENDER_ID=ciro                 # approved sender id (deployment: SMS_SENDER)
SMS_ENDPOINT_URL=https://api.taqnyat.sa/v1/messages

# ── spec 015: web dashboard authentication ───────────────────────────────────
# FR-032/042 — how many concurrent, independently-revocable sessions one
# administrator may hold. Beyond this, a new sign-in evicts the oldest. `1`
# reproduces today's single-session displacement behaviour for admins.
AUTH_MAX_ADMIN_SESSIONS=3

# FR-013/021/023/024/025/026 — the passwordless admin sign-in code and its
# abuse controls. Expiry / max-attempts / max-requests / window mirror the
# PASSWORD_RESET_* defaults deliberately: one posture across both anonymous
# code flows.
LOGIN_OTP_EXPIRY_MINUTES=5
LOGIN_OTP_MAX_ATTEMPTS=5
LOGIN_OTP_MAX_REQUESTS=3
LOGIN_OTP_WINDOW_MINUTES=15
# Rate-limited requests for a number before a proof-of-work challenge is demanded.
LOGIN_OTP_CHALLENGE_AFTER=2
# Failed verifications ACROSS separately-issued codes before a temporary block.
LOGIN_OTP_FAIL_THRESHOLD=10
LOGIN_OTP_BLOCK_MINUTES=60
# Proof-of-work: leading zero bits required of sha256(seed || nonce). `0`
# disables the search entirely — the value the e2e environment uses, and the
# production escape hatch if the challenge ever locks a real administrator out.
# Opt-in ONLY, and a deliberate security downgrade wherever it is on. With this true,
# requesting a sign-in code for a number that belongs to no administrator fails with
# PHONE_NOT_REGISTERED instead of the neutral 202 FR-015 mandates — which turns the login
# endpoint into an oracle for "is this mobile number a platform administrator", the
# targeting step before SIM-swap or phishing. It exists because the neutral response makes
# a mistyped digit and a dead SMS provider look identical, which costs real time in
# development. Leave it false (or absent) in production.
LOGIN_CODE_REVEAL_UNKNOWN_PHONE=false

LOGIN_POW_DIFFICULTY_BITS=18
LOGIN_POW_SEED_TTL_SECONDS=300

# ── spec 012: production hardening ────────────────────────────────────────────
# Operational only. None of these changes what the platform does — only how it
# is run and observed. Defaults shown are the development ones.

# Story 1 — health signals. HEALTH_TIMEOUT_MS bounds each dependency check so a
# slow database resolves as "down" rather than leaving the probe outstanding; a
# readiness endpoint that hangs looks, to a proxy, exactly like a dead instance.
HEALTH_TIMEOUT_MS=1000
# Identifies this instance in health responses and log records. Defaults to the
# machine hostname; set explicitly when running several instances on one host.
INSTANCE_ID=
# The steady-state readiness monitor's cadence. Open-source nginx CANNOT poll a
# health endpoint (that is nginx Plus), so an external monitor is what carries
# the 30-second detection guarantee: 3 failures x 10s.
READINESS_POLL_INTERVAL_SECONDS=10
READINESS_FAILURE_THRESHOLD=3
READINESS_RECOVERY_THRESHOLD=3

# Story 2 — graceful shutdown. Must exceed the proxy's health-check interval,
# or new traffic still arrives while the instance is draining.
SHUTDOWN_DRAIN_MS=30000

# Story 3 — browser access. REQUIRED in production: the service refuses to start
# without it, because starting with browser access silently broken presents as
# an authentication failure and gets diagnosed as one. Exact-match, comma
# separated; scheme, host and port all significant, and a trailing slash fails.
# The same list governs the API, the WebSocket namespace and the bucket's CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Story 4 — client attribution behind a proxy. DELIBERATELY UNSET: there is no
# safe default. It is 1 when nginx is the only proxy and 2 when a managed load
# balancer fronts it. Setting 1 where there are 2 makes the load balancer the
# attributed client for EVERY request on the platform — the same
# undifferentiated-origin failure this story exists to fix, and it produces no
# error and no symptom. Establish the topology first, then set it.
# TRUSTED_PROXY_HOPS=

# Story 5 — structured records. Collected volume is billable, so the production
# default must not emit per database operation or per position update: the
# tracking stream alone would dominate. LOG_PRETTY is dev-only — production must
# stay newline-delimited JSON or the logging agent cannot preserve fields.
LOG_LEVEL=debug
LOG_PRETTY=true

# Story 6 — durable documents. 'local' writes to a real sys_storge directory and
# is what development and all 53 e2e suites use; 'gcs' writes to the regional
# bucket. The download route issues a 302 under BOTH, so tests and production
# exercise one code path rather than the redirect running first in production.
STORAGE_DRIVER=local
GCS_BUCKET=
SIGNED_URL_TTL_SECONDS=300
# The local driver's byte route is addressed by a signed token in the URL, never
# by the Authorization header: clients differ in whether they forward that
# header across a redirect, so an authenticated local route would pass for some
# clients and fail for others. Derived from JWT_SECRET when unset.
LOCAL_STORAGE_TOKEN_TTL_SECONDS=300
LOCAL_STORAGE_TOKEN_SECRET=

# Story 7 — secrets. 'env' is a complete no-op: process.env is already populated,
# so development and every test are untouched. 'gcp' fetches each name in the
# manifest via the VM's attached service identity and writes it into process.env
# BEFORE Nest boots — which is why an absent secret still fails in Joi, in the
# same place and the same way an absent config value does.
SECRETS_DRIVER=env
GCP_PROJECT_ID=
SECRETS_MANIFEST=

# Story 8 — database resilience. Explicit bounds so a brief interruption fails
# fast and recovers rather than piling requests up. MONGO_SOCKET_TIMEOUT_MS must
# exceed the longest legitimate transaction (dispatch assignment, payment
# webhook) — set too low, this resilience work becomes a data-integrity bug.
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=2
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_WAIT_QUEUE_TIMEOUT_MS=10000

# Story 9 — running more than one instance. The lease TTL sits above the
# measured p99 sweep duration and below the 60s sweep interval, so a dead
# holder's lease expires before the next tick rather than stalling the schedule.
# NOTE: the lease is at-most-once, NOT exactly-once — a pause outlasting the TTL
# still permits a concurrent run, which is why every sweep must be idempotent.
SCHEDULER_LEASE_TTL_MS=55000
SCHEDULER_LEASE_ENABLED=true

# Feature 013 (fuel company admin dashboard) FR-062b — the commission
# ceiling that governs a fuel company for which the operator has set none,
# so no company is ever without one. REQUIRED, no platform default: this is
# a real financial policy decision, not an operational knob — set it to the
# figure the business has actually chosen before deploying.
PLATFORM_DEFAULT_COMMISSION_CEILING=100000
