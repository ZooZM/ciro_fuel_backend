NODE_ENV=development
PORT=3000

# MongoDB (replica set REQUIRED for transactions)
MONGODB_URI=mongodb://localhost:27017/ciro_fuel?replicaSet=rs0

# Redis (BullMQ payment-timeout delayed jobs)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-to-a-random-64-hex-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-a-different-random-64-hex-string
JWT_REFRESH_EXPIRES_IN=7d

# Payment gateways (Sadad/Mada webhook HMAC secrets)
PAYMENT_SADAD_SECRET=change-me
PAYMENT_MADA_SECRET=change-me
PAYMENT_DEADLINE_MINUTES=30

# Proof of delivery
OTP_EXPIRY_MINUTES=30

# File storage — directory name MUST remain exactly "sys_storge"
STORAGE_DIR=sys_storge
MAX_FILE_SIZE_BYTES=10485760

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Driver presence
PRESENCE_OFFLINE_MINUTES=6
PRESENCE_SWEEP_SECONDS=60

# Tracking policy
TRACKING_DISPLACEMENT_METERS=50
TRACKING_HEARTBEAT_MINUTES=3

# Seed script (scripts/seed-super-admin.ts)
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_PASSWORD=change-me-please-16chars
SUPER_ADMIN_FULL_NAME=Platform Owner
